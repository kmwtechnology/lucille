<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kmwllc</groupId>
    <artifactId>lucille-parent</artifactId>
    <version>0.13.0-SNAPSHOT</version>
    <relativePath>../lucille-parent/pom.xml</relativePath>
  </parent>

  <artifactId>lucille-plugins</artifactId>
  <packaging>pom</packaging>
  <name>Lucille Plugins</name>

  <modules>
    <module>lucille-api</module>
    <module>lucille-pinecone</module>
    <module>lucille-weaviate</module>
    <module>lucille-elasticsearch</module>
    <module>lucille-opensearch</module>
    <module>lucille-solr</module>
    <module>lucille-parquet</module>
    <module>lucille-tika</module>
    <module>lucille-ocr</module>
    <module>lucille-jlama</module>
    <module>lucille-entity-extraction</module>
    <module>lucille-video</module>
  </modules>

  <properties>
    <!-- Lifecycle phase the plugin modules bind maven-shade-plugin to. "none" skips building the
         shaded *-plugin.jar (hundreds of MB for some plugins, unused by tests). Activate the
         shaded-plugin-jars profile to build it: mvn package -Pshaded-plugin-jars -->
    <shaded-plugin-jar.phase>none</shaded-plugin-jar.phase>
    <!-- Set to true in modules with no components to document (lucille-api, lucille-admin-ui) -->
    <component-javadocs.skip>false</component-javadocs.skip>
  </properties>

  <build>
    <plugins>
      <!-- Writes this plugin's component javadoc (stages, connectors, indexers) to lucille-component-javadocs.json in the
           jar, using lucille-core's JsonDoclet. The Admin API's config-info endpoints merge this file from every jar on
           the classpath, so the UI shows descriptions for plugin components too, not only core's (whose docs
           run-jsondoclet.sh generates into lucille-api). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <id>component-javadocs</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>javadoc-no-fork</goal>
            </goals>
            <configuration>
              <skip>${component-javadocs.skip}</skip>
              <doclet>com.kmwllc.lucille.doclet.JsonDoclet</doclet>
              <docletArtifacts>
                <docletArtifact>
                  <groupId>com.kmwllc</groupId>
                  <artifactId>lucille-core</artifactId>
                  <version>${project.version}</version>
                  <!-- resolved with its dependencies, which include the gson the doclet writes JSON with -->
                </docletArtifact>
              </docletArtifacts>
              <useStandardDocletOptions>false</useStandardDocletOptions>
              <subpackages>com.kmwllc.lucille</subpackages>
              <additionalOptions>
                <additionalOption>-o lucille-component-javadocs.json</additionalOption>
                <additionalOption>-d ${project.build.outputDirectory}</additionalOption>
              </additionalOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>shaded-plugin-jars</id>
      <properties>
        <shaded-plugin-jar.phase>package</shaded-plugin-jar.phase>
      </properties>
    </profile>
    <profile>
      <id>admin-ui</id>
      <modules>
        <module>lucille-api/lucille-admin-ui</module>
      </modules>
    </profile>
  </profiles>

  <dependencies>

  </dependencies>
</project>
