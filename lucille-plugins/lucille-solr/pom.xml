    <!-- Floor for the Jetty 12.0.x set: solr-solrj-jetty pulls 12.0.27 (CVE-2026-19203 and
    CVE-2026-2332 in jetty-http, CVE-2026-12611 in jetty-http2-common, CVE-2026-8384 in
    jetty-util). jetty-http2-client-transport is the root of that chain, so flooring it lifts the
    other client modules with it; Jetty modules must all share one version. Declared ahead of the
    Solr modules below, since Maven breaks the equal-depth tie on declaration order. Not
    test-scoped so they propagate downstream. -->
    <dependency>
      <groupId>org.eclipse.jetty.http2</groupId>
      <artifactId>jetty-http2-client-transport</artifactId>
      <version>${jetty12.version}</version>
    </dependency>
    <!--  Note that http2-common and http2-hpack also arrive via solr-test-framework, which declares
       them at compile scope, so the transport floor above does not reach them. -->
    <dependency>
      <groupId>org.eclipse.jetty.http2</groupId>
      <artifactId>jetty-http2-common</artifactId>
      <version>${jetty12.version}</version>
    </dependency>
    <dependency>
