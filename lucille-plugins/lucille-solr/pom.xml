  <build>
    <plugins>
      <!-- Bind failsafe's integration-test/verify goals so SolrIndexerIT (a *IT test that spins up
           MiniSolrCloudCluster) runs on `mvn verify`. The argLine (including
           -Dtest.solr.allowed.securerandom) is inherited from lucille-parent. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <!-- Configuration that alleviates the Solr test framework after the upgrade to Solr 10.0 (moved here with
             SolrIndexerIT from lucille-core): point the test at the built jar and supply tests.src.home so Solr's
             ExternalPaths can determine a source home instead of throwing "Failed to determine source home". -->
        <configuration>
          <classesDirectory>target/fake</classesDirectory>
          <additionalClasspathElements>
            <additionalClasspathElement>${basedir}/target/${project.build.finalName}.jar</additionalClasspathElement>
          </additionalClasspathElements>
          <systemPropertyVariables>
            <tests.src.home>${project.build.testOutputDirectory}</tests.src.home>
          </systemPropertyVariables>
        </configuration>
        <!-- Pin the JUnit 4 provider, matching lucille-parent's surefire config. Without it, failsafe falls back to
             the junit-platform vintage engine, which fails to parse the junit:junit 4.13.2 version and aborts. -->
        <dependencies>
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit47</artifactId>
            <version>${maven-surefire-plugin.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>${shaded-plugin-jar.phase}</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>${project.artifactId}-plugin</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>log4j2.properties</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
