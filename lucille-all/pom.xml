<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kmwllc</groupId>
    <artifactId>lucille-parent</artifactId>
    <version>0.13.0-SNAPSHOT</version>
    <relativePath>../lucille-parent/pom.xml</relativePath>
  </parent>

  <artifactId>lucille-all</artifactId>
  <packaging>jar</packaging>
  <name>Lucille: All Components</name>
  <description>
    Aggregator module that bundles lucille-core together with every pipeline-component plugin
    (search backends, vector stores, document/ML plugins). It produces no sources of its own as its
    purpose is to assemble a single runtime classpath (target/lib) containing all components. It is used
    to build the "lucille-all" Docker image. The Admin API (lucille-api) is included, so the image can run it
    (LUCILLE_ROLE=api) with every component available. The Admin UI jar is added when the admin-ui profile is
    active (it needs Node to build).

    Each plugin jar is kept separate (not shaded together), so that per-jar
    META-INF/services/com.kmwllc.lucille.core.Indexer files are all present and read from the
    classpath at runtime, and so native/platform-specific dependencies do not collide.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <!-- Same as lucille-api (see dependencyManagement below) -->
    <jetty.version>12.1.13</jetty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Core's OTel BOM doesn't reach this classpath; without it, google-cloud-storage's 1.62.0 ships. -->
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- lucille-api's CVE pins. Imported BOMs and managed versions don't carry over through a dependency, so without
           these lucille-all would ship the Jetty and hibernate-validator versions Dropwizard pulls in. Keep in sync
           with lucille-plugins/lucille-api/pom.xml. -->
      <dependency>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jetty.ee10</groupId>
        <artifactId>jetty-ee10-bom</artifactId>
        <version>${jetty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.hibernate.validator</groupId>
        <artifactId>hibernate-validator</artifactId>
        <version>8.0.6.Final</version>
      </dependency>
      <!-- Versions lucille-api resolves on its own but that a plugin's older one would otherwise win here (Maven picks the
           nearest declaration). jakarta.annotation-api 1.3.5 (from opensearch-java) still uses the javax.annotation
           package, so Dropwizard fails with ClassNotFoundException: jakarta.annotation.Priority. javax.annotation-api
           still supplies the javax classes for the plugins that use them. -->
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>2.1.1</version>
      </dependency>
      <!-- Dropwizard's jersey needs 3.31.0-GA; jlama's jinjava would otherwise pull 3.30.2-GA -->
      <dependency>
        <groupId>org.javassist</groupId>
        <artifactId>javassist</artifactId>
        <version>3.31.0-GA</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-logging</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-solr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-opensearch</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-elasticsearch</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-pinecone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-weaviate</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-parquet</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-tika</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-ocr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-jlama</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-entity-extraction</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-video</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The Admin API. Its ConfigInfo endpoints scan the classpath, so every component above shows up in the UI. -->
    <dependency>
      <groupId>com.kmwllc</groupId>
      <artifactId>lucille-api</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Same id as the lucille-plugins profile that builds lucille-admin-ui, so one -Padmin-ui flag builds the UI jar
         and adds it to target/lib. A plain build (no Node) still works and serves the API without /admin. -->
    <profile>
      <id>admin-ui</id>
      <dependencies>
        <dependency>
          <groupId>com.kmwllc</groupId>
          <artifactId>lucille-admin-ui</artifactId>
          <version>${project.version}</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

  <build>
    <extensions>
      <!-- Resolves ${os.detected.name}/${os.detected.arch}, which lucille-jlama's native dependency
           (jlama-native) uses as its classifier. lucille-jlama declares this extension in its own build, but
           build extensions are not inherited through a dependency, so lucille-all must declare it too to
           resolve the transitive native artifact. This makes lucille-all platform-specific for the jlama
           native bits, which is expected for the batteries-included bundle. -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.0</version>
      </extension>
    </extensions>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.1.1</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
